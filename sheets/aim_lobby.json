{
  "_sheet": "aim_lobby",
  "_doc": "The aim-train arena far above and away from the surf course. Lengths in metres, positions relative to 'center' unless noted (x right, y up, z toward the spawn; the back wall is at -z). track_speed_u is Hammer units/s (CS2 run speed) converted with movement.json unit_to_m. Bot size comes from movement.json hull_height/hull_width.",
  "columns": ["id", "value", "what"],
  "rows": [
    {"id": "center", "value": [0, 300, 600], "what": "world position of the arena floor centre (course.json spans x -270..630, y 0..92, z -450..450, so this never overlaps)"},
    {"id": "arena_size", "value": [60, 40], "what": "floor x and z extent"},
    {"id": "wall_height", "value": 10, "what": "wall height above the floor"},
    {"id": "wall_thickness", "value": 1, "what": "wall thickness"},
    {"id": "ground_size", "value": 400, "what": "terrain slab under and around the arena"},
    {"id": "spawn_offset", "value": [0, 0.05, 17], "what": "player feet relative to center"},
    {"id": "spawn_yaw", "value": 0, "what": "degrees; 0 faces -z, the back wall"},
    {"id": "round_s", "value": 30, "what": "round length in seconds"},
    {"id": "summary_s", "value": 5, "what": "seconds the round summary stays up before the next round starts"},
    {"id": "points_hit", "value": 10, "what": "score per hit"},
    {"id": "points_head", "value": 5, "what": "bonus score per head hit"},
    {"id": "best_file", "value": "user://aim_best.json", "what": "best score per mode"},
    {"id": "floor_material", "value": "pad", "what": "materials.json id"},
    {"id": "wall_material", "value": "ramp_concrete", "what": "materials.json id"},
    {"id": "cover_material", "value": "ramp_panels", "what": "materials.json id"},
    {"id": "ground_material", "value": "terrain", "what": "materials.json id"},
    {"id": "cover", "value": [[-14, 3, 3, 1.2, 1], [14, -5, 4, 1.1, 1], [-20, -10, 2, 1, 2], [21, 8, 2, 1.3, 2], [-9, -12, 3, 0.9, 1], [10, 11, 3, 1, 1]], "what": "low cover boxes: x, z, size x, height, size z (relative to center)"},
    {"id": "flick_radius", "value": 0.4, "what": "flick target sphere radius"},
    {"id": "flick_margin", "value": 3, "what": "keep flick targets this far from the side walls"},
    {"id": "flick_y", "value": [1.0, 6.0], "what": "flick target height range above the floor"},
    {"id": "flick_gap", "value": 0.6, "what": "flick target distance in front of the back wall"},
    {"id": "track_distance", "value": 20, "what": "tracking target distance from the spawn"},
    {"id": "track_half_range", "value": 12, "what": "tracking target strafes x +- this"},
    {"id": "track_speed_u", "value": 250, "what": "strafe speed in Hammer units/s (CS2 run speed)"},
    {"id": "track_flip_s", "value": [0.6, 1.8], "what": "min/max seconds before the target reverses"},
    {"id": "bot_distances", "value": [10, 20, 30], "what": "bot distances from the spawn"},
    {"id": "bot_x", "value": [-4, 0, 4], "what": "bot x offsets, same order as bot_distances"},
    {"id": "bot_hp", "value": 100, "what": "bot health; dead bots stand back up after bot_respawn_s"},
    {"id": "bot_head_radius", "value": 0.14, "what": "bot head sphere radius"},
    {"id": "bot_respawn_s", "value": 0.8, "what": "seconds a downed bot stays down"},
    {"id": "color_flick", "value": [1.0, 0.35, 0.1], "what": "linear rgb"},
    {"id": "color_track", "value": [1.0, 0.8, 0.1], "what": "linear rgb"},
    {"id": "color_bot", "value": [0.45, 0.4, 0.28], "what": "linear rgb"},
    {"id": "color_head", "value": [0.9, 0.15, 0.1], "what": "linear rgb"},
    {"id": "color_lane", "value": [0.9, 0.75, 0.15], "what": "distance marker stripes on the floor"}
  ],
  "modes": [
    {"id": "flick", "label": "FLICK"},
    {"id": "track", "label": "TRACK"},
    {"id": "bots", "label": "BOTS"}
  ]
}
