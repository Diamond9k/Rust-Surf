		m_iMaxClip1 = 30
		m_flCycleTime =
		[
			0.1,
			0.1,
		]
		m_flMaxSpeed = { m_flValues = [ 215.0, 215.0 ] }
		m_flSpread = [ 0.6, 0.6 ]
		m_flInaccuracyFire = [ 7.8, 7.8 ]
		m_flRecoilMagnitude = [ 30.0, 30.0 ]
		m_nRecoilSeed = 223
		m_flRangeModifier = 0.98
		m_szDescription = """A line with "quotes"
and a second line"""
		m_vecMuzzle = [ 1.5e-1, -2, 3 ]
		m_blob = #[ 00 01 02 ]
		m_pNull = null
	}
	weapon_glock =
	{
