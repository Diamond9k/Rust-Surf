// Synthetic weapons.vdata for prep/tests. Written by hand, not copied from CS2: the layout (entries keyed by
// weapon name, [primary, alt] pairs, a _base entry, typed resource values) is a guess at what VRF writes for
// a decompiled CS2 .vdata_c and is unverified. The numbers are test values, not CS2 facts.
{
	generic_data_type = "CCSWeaponBaseVData"
	/* a block comment
	   spanning lines { not a block } */
	weapon_rifle_base =
	{
		_class = "CCSWeaponBaseVData"
		m_bIsFullAuto = true
		m_flHeadshotMultiplier = 4.0
		m_flPenetration = 2.0
		m_nNumBullets = 1
	}
	weapon_ak47 =
	{
		_class = "CCSWeaponBaseVData"
		_base = "weapon_rifle_base"
		m_szModel_AG2 = resource_name:"weapons/models/ak47/weapon_rif_ak47_ag2.vmdl"
		m_sSilencedSound = soundevent:""
