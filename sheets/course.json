  "terrain": {
    "_doc": "Ground built by Backdrop.gd in course coordinates: the site levels, the launch pad pit (found at load time from the placed meshes, so it follows the player's Rust version) and hills outside site_rect. layers name materials.json rows: open ground, dirt (slopes, patches, pit floor), site concrete (patches inside site_rect). blend_materials: Rust material names on placed meshes (mounds, slopes, tower footings, pit banks) that are drawn with the terrain shader so they merge into the ground instead of standing out as smooth blobs (Rust blends them with its terrain; how exactly is unverified).",
    "layers": [
      "terrain",
      "dirt",
      "ground"
    ],
    "base_y": 0,
    "steps": [
      {
        "x0": 27,
        "x1": 63,
        "dy": -6,
        "_doc": "west of x0 the ground is 6 m lower, rising to base_y at x1: matches the two range_terrain_slope meshes (course x 27..63, y -6..-0.1)"
      }
    ],
